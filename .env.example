# Copy this file to .env.local for local development overrides
# The Firebase config is already hardcoded in src/firebase.js (safe for web apps)

# ─── Cloud Functions Secrets ─────────────────────────────────────────────────
# Set these via Firebase CLI (never commit real values):
#   firebase functions:secrets:set GEMINI_API_KEY
#   firebase functions:secrets:set EMAIL_USER
#   firebase functions:secrets:set EMAIL_PASS
#
# GEMINI_API_KEY  = your Google AI Studio API key (gemini-1.5-flash)
# EMAIL_USER      = the email address used to SEND notifications (Gmail or SMTP)
# EMAIL_PASS      = Gmail app password (https://myaccount.google.com/apppasswords)
#                   or your SMTP provider password
#
# EMAIL_HOST is optional — defaults to smtp.gmail.com
# If using a different provider, set it in functions/index.js

# ─── Live MLS Feed (optional) ────────────────────────────────────────────────
# getMlsListings works out of the box against SimplyRETS' public demo account
# (their own documented test credentials — simplyrets/simplyrets), so the
# prospect site always shows real live-API listings, not hardcoded mock data.
#
# To show YOUR actual MLS inventory instead of SimplyRETS demo data, sign up
# for a SimplyRETS IDX/RESO feed (simplyrets.com) tied to your MLS, then set:
#   functions/.env.<project-id>   (create this file, it's gitignored)
#     SIMPLYRETS_USER=your_username
#     SIMPLYRETS_PASS=your_password
# No redeploy of the function code is needed — just redeploy functions after
# adding the file: `firebase deploy --only functions`

# ─── Realtor Login ────────────────────────────────────────────────────────────
# The CRM portal (/portal) requires signing in with Google as the email set
# in src/config.js (REALTOR.allowedEmail) — this must match the email hardcoded
# in firestore.rules' isRealtor() check, or reads/writes will be denied. Add
# that email as a Sign-in method > Google user in the Firebase Auth console.

# ─── Firebase Hosting Target ─────────────────────────────────────────────────
# After `firebase init hosting`, your site will be at:
#   https://ignite-33d2d.web.app
